DATABASE_URL=postgres://postgres:postgres@localhost:5432/gruntdeck?sslmode=disable

# Used to encrypt stored credentials (AES-256-GCM). Generate with:
#   openssl rand -hex 32
GRUNTDECK_MASTER_KEY=

ADMIN_USERNAME=admin
# Password for the bootstrapped initial admin user.
ADMIN_PASSWORD=

# Directory that job step `source_path` values are confined to. Job definitions come
# from API users, so anything readable under this root can be shipped to a remote node
# — keep it separate from config and keys. Defaults to ./scripts.
GRUNTDECK_SCRIPT_DIR=
